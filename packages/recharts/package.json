{
  "name": "@preactcn/recharts",
  "version": "3.8.0-preact.1",
  "private": true,
  "description": "recharts converted to Preact: the upstream source with its React imports redirected to a small Preact adapter",
  "license": "MIT",
  "type": "module",
  "sideEffects": [
    "./dist/_runtime/adapter.js"
  ],
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    }
  },
  "files": [
    "dist",
    "LICENSE"
  ],
  "scripts": {
    "generate": "pnpm --dir ../pipeline recharts",
    "build": "node scripts/build.ts",
    "pack:local": "node scripts/pack.ts",
    "test": "vitest run",
    "test:preact11": "PREACT=11 vitest run",
    "typecheck": "node test/global-setup.ts && tsc --noEmit",
    "typecheck:preact11": "node test/global-setup.ts && tsc --noEmit -p tsconfig.preact11.json"
  },
  "peerDependencies": {
    "preact": ">=10.29 <12"
  },
  "dependencies": {
    "@reduxjs/toolkit": "^2.11.0",
    "clsx": "^2.1.1",
    "decimal.js-light": "^2.5.1",
    "es-toolkit": "^1.39.3",
    "eventemitter3": "^5.0.1",
    "immer": "^11.0.0",
    "reselect": "5.1.1",
    "tiny-invariant": "^1.3.3",
    "victory-vendor": "^37.0.2"
  },
  "devDependencies": {
    "@types/node": "^26.6.5",
    "happy-dom": "^20.14.6",
    "preact": "^10.29.8",
    "preact-render-to-string": "^6.8.0",
    "preact11": "npm:preact@11.0.1",
    "typescript": "^7.0.2",
    "vitest": "^5.0.3"
  }
}
