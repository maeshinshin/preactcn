---
import Layout from "../layouts/Layout.astro";
import { buttonVariants } from "../components/ui/button";
import { Separator } from "../components/ui/separator";
import CopyButton from "../chrome/CopyButton";
import { grouped, items } from "../items";
const base = import.meta.env.BASE_URL.replace(/\/$/, "");
const command = "npx shadcn@latest add @preactcn/button";
---
<Layout title="preactcn">
  <section class="rounded-2xl border bg-gradient-to-br from-brand/10 via-transparent to-transparent p-6 md:p-10">
    <h1 class="max-w-2xl text-3xl font-semibold tracking-tight text-balance md:text-5xl">shadcn/ui for <span class="text-brand">Preact</span></h1>
    <p class="mt-3 max-w-xl text-muted-foreground">{items.length} components converted from every upstream release, copied into your project with the official shadcn CLI. No React, no <code>preact/compat</code>; every example below runs live.</p>
    <div class="mt-6 flex max-w-xl items-center gap-1 rounded-lg border bg-card py-1 pr-1 pl-3 font-mono text-sm">
      <span class="text-brand select-none">$</span>
      <code class="min-w-0 flex-1 overflow-x-auto py-1.5 whitespace-nowrap">{command}</code>
      <CopyButton client:load text={command} label="Copy command" />
    </div>
    <div class="mt-4 flex flex-wrap gap-2">
      <a class={buttonVariants({ size: "lg" })} href={`${base}/components/button/`}>Browse components</a>
      <a class={buttonVariants({ size: "lg", variant: "outline" })} href={`${base}/setup/`}>Setup</a>
    </div>
  </section>
  {grouped.map((g) => (
    <section class="mt-10">
      <h2 class="mb-1 text-lg font-semibold">{g.category}</h2>
      <Separator className="mb-4" />
      <div class="grid grid-cols-2 gap-3 sm:grid-cols-3 lg:grid-cols-4">
        {g.items.map((i) => (
          <a class="rounded-xl border bg-card px-4 py-3 text-sm font-medium transition-colors hover:border-brand/60 hover:bg-brand/5 hover:text-brand" href={`${base}/components/${i.name}/`}>{i.name}</a>
        ))}
      </div>
    </section>
  ))}
</Layout>
