---
import { Code } from "astro:components";
import Layout from "../../layouts/Layout.astro";
import Islands from "../../islands/Islands.astro";
import { Badge } from "../../components/ui/badge";
import { Separator } from "../../components/ui/separator";
import CopyButton from "../../chrome/CopyButton";
import PreviewTabs from "../../chrome/PreviewTabs";
import { items } from "../../items";
import sections from "../../sections.json";
import { Toaster } from "../../components/ui/sonner";

export function getStaticPaths() {
  return items.map((item) => ({ params: { name: item.name }, props: { item } }));
}
const { item } = Astro.props;
const example = item.example ? (sections as Record<string, { full: string; sections: { fn: string; id: string; title: string; code: string }[] }>)[item.name] : undefined;
const parts = example?.sections ?? [];
const whole = parts.length === 1 && !parts[0].title; // an example that does not split into sections: one preview, one code block
const theme = { light: "github-light", dark: "github-dark" };
const command = `npx shadcn@latest add @preactcn/${item.name}`;
---
<Layout title={`${item.name} - preactcn`} current={item.name} toc={whole ? [] : parts}>
  <div class="mx-auto max-w-5xl">
    <Badge variant="secondary">{item.category}</Badge>
    <h1 class="mt-2 text-3xl font-semibold tracking-tight">{item.name}</h1>
    {item.docs && <p class="mt-1 text-sm text-muted-foreground">Same API as upstream: <a class="text-brand underline underline-offset-4" href={item.docs}>shadcn/ui docs</a></p>}
    <div class="mt-5 flex items-center gap-1 rounded-lg border bg-card py-1 pr-1 pl-3 font-mono text-sm">
      <span class="text-brand select-none">$</span>
      <code class="min-w-0 flex-1 overflow-x-auto py-1.5 whitespace-nowrap">{command}</code>
      <CopyButton client:load text={command} label="Copy command" />
    </div>
    <Separator className="my-6" />
    {parts.map((part) => (
      <section class="mb-10 scroll-mt-20" id={whole ? undefined : part.id}>
        {!whole && <h2 class="mb-3 text-lg font-medium tracking-tight"><a class="hover:underline" href={`#${part.id}`}>{part.title}</a></h2>}
        <PreviewTabs client:load id={part.id} />
        <div id={`${part.id}-preview`} data-preview data-example data-section data-titled={whole ? undefined : ""} class="mt-3 overflow-clip rounded-xl border bg-muted p-4 sm:p-6 dark:bg-background">
          <Islands name={item.name} section={part.fn} />
        </div>
        <div id={`${part.id}-code`} hidden class="mt-3 overflow-hidden rounded-xl border bg-card">
          <div class="flex items-center justify-between border-b bg-muted/50 py-1 pr-1 pl-4">
            <span class="font-mono text-xs text-muted-foreground">{whole ? `${item.name}-example.tsx` : part.fn}</span>
            <CopyButton client:visible target={`${part.id}-source`} label="Copy source" />
          </div>
          <div id={`${part.id}-source`} class="max-h-[36rem] overflow-auto">
            <Code code={part.code} lang="tsx" themes={theme} defaultColor={false} />
          </div>
        </div>
      </section>
    ))}
    {example && !whole && (
      <details class="mb-10 rounded-xl border bg-card">
        <summary class="cursor-pointer px-4 py-2.5 text-sm font-medium">Full example source</summary>
        <div class="flex items-center justify-between border-y bg-muted/50 py-1 pr-1 pl-4">
          <span class="font-mono text-xs text-muted-foreground">{item.name}-example.tsx</span>
          <CopyButton client:visible target="full-source" label="Copy source" />
        </div>
        <div id="full-source" class="max-h-[36rem] overflow-auto">
          <Code code={example.full} lang="tsx" themes={theme} defaultColor={false} />
        </div>
      </details>
    )}
    {example && <Toaster client:load />}
  </div>
</Layout>
